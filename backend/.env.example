# =============================================================================
# 🛡️ Backend Environment Variables Template (Supabase & FastAPI)
# =============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
APP_MODE=replay
API_HOST=0.0.0.0
API_PORT=8000

# Supabase & PostgreSQL
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Comma-separated frontend origins permitted to call this API.
CORS_ORIGINS=http://localhost:5173

# Blockchain
BLOCKCHAIN_ENABLED=true
WEB3_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
SMART_CONTRACT_ADDRESS=0x71C84167B33ab71e0FE3b299c0E25F6C665673E0
SIGNER_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
