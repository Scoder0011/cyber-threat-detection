# =============================================================================
# 🛡️ AI-Powered Cyber Threat Detection System - Environment Variables Template
# =============================================================================

# --- General & Runtime Mode ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_MODE=replay                  # replay | live
API_HOST=0.0.0.0
API_PORT=8000

# --- Supabase & PostgreSQL Persistence ---
# Replace with your Supabase Project Settings -> Database & API keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# --- Redis Streaming & Event Bus ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Web3 & Blockchain Audit Trail ---
BLOCKCHAIN_ENABLED=true
WEB3_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
SMART_CONTRACT_ADDRESS=0x71C84167B33ab71e0FE3b299c0E25F6C665673E0
SIGNER_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- AI Models & Detection Thresholds ---
DDOS_PPS_THRESHOLD=10000
BEACON_JITTER_TOLERANCE=0.10
DGA_ENTROPY_THRESHOLD=3.85
EXFILTRATION_OUTBOUND_RATIO=50.0

# --- Ingestion Engine ---
REPLAY_SPEED_MULTIPLIER=1.0      # 1.0 = real-time, 2.0 = 2x speed, etc.
CAPTURE_INTERFACE=eth0           # Used only in live mode
