# ── ThreatLens Frontend Environment Configuration ────────────────────────────

# Deployed Backend API URL (FastAPI / AI Models Server)
VITE_API_BASE_URL=http://localhost:8000/api

# Deployed WebSocket URL for live alert streaming
VITE_WS_URL=ws://localhost:8000/api/alerts/ws

# Supabase Cloud Project Configuration (for Direct DB Queries & Realtime Alerts)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Mock Mode (Set to true only for local isolated unit tests)
VITE_USE_MOCK=false
