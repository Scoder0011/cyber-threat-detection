# Point these at your live FastAPI backend (backend/app/main.py)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000 # set to wss://<host> for a deployed HTTPS backend
# The bundled backend does not currently implement these optional live endpoints.
VITE_ENABLE_LIVE_FEATURES=false
VITE_ENABLE_ALERTS_SOCKET=false
