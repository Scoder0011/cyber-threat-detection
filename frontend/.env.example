# ── ThreatLens Frontend Environment Variables ──────────────────────────────
# URL of the backend FastAPI service
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket URL for live alert streaming
VITE_WS_URL=ws://localhost:8000/api/alerts/ws

# When set to "true", the frontend uses local deterministic mock data for tests
VITE_USE_MOCK=false
