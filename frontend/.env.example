# ── ThreatLens Frontend Environment Configuration ────────────────────────────

# Deployed Backend API URL (FastAPI / AI Models Server)
VITE_API_BASE_URL=https://three-1-1oz2.onrender.com/api

# Deployed WebSocket URL for live alert streaming
VITE_WS_URL=wss://three-1-1oz2.onrender.com/api/alerts/ws

# Required for live dashboard telemetry and Supabase authentication.
# Use the public Project URL and anon/publishable key only; never place a service-role key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# The frontend no longer falls back to mock data when this is unset.
